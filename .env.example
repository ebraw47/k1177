# Site URL - used for canonical URLs, sitemaps, and metadata
NEXT_PUBLIC_SITE_URL=https://k1177apk.com.pk

# Optional: override the Download button URL (defaults to referral invite link in constants.ts)
# NEXT_PUBLIC_DOWNLOAD_URL=https://k1177.com/inviteuser/eWSPJc

# Optional Facebook page
# NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/

# Google Analytics 4 measurement ID (optional).
# Get it from https://analytics.google.com/ → Admin → Data Streams → your web stream.
# Leave unset or set to G-XXXXXXXXXX to disable GA scripts.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
